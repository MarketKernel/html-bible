{
  "name": "verse-create-invalid-ref",
  "description": "Malformed or impossible references: 400 invalid_ref.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/arguments/01JAS000000000000000000A02/verses",
        "headers": {
          "Authorization": "Bearer <token:elena>"
        },
        "body": {
          "ref": {
            "from": "JHN.3.18",
            "to": "JHN.3.16"
          }
        }
      },
      "response": {
        "status": 400,
        "body": {
          "error": {
            "code": "invalid_ref",
            "message": "A range must not end before it starts",
            "field": "ref"
          }
        }
      }
    }
  ]
}
