            "invitedBy": {
              "id": "00000000-0000-4000-8000-000000000001",
              "displayName": "root"
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/auth/password",
        "headers": {
          "Authorization": "Bearer {here}"
        },
        "body": {
          "password": "wrong one",
          "newPassword": "a new secret"
        }
      },
      "response": {
        "status": 403,
        "body": {
          "error": {
            "code": "wrong_password",
            "message": "The current password is wrong",
            "field": "password"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/auth/password",
        "headers": {
          "Authorization": "Bearer {here}"
        },
        "body": {
          "password": "elena-demo",
          "newPassword": "short"
        }
      },
      "response": {
        "status": 400,
        "body": {
          "error": {
            "code": "validation_error",
            "message": "\"newPassword\" must be 8–128 characters",
            "field": "newPassword"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/auth/password",
        "headers": {
          "Authorization": "Bearer {here}"
        },
        "body": {
          "password": "elena-demo",
          "newPassword": "a new secret"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "revoked": 1
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/v1/me",
        "headers": {
          "Authorization": "Bearer {here}"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "5cbfc5b0-9bd2-5637-bfe0-7d28368f5ace",
          "number": 4,
          "login": "elena",
