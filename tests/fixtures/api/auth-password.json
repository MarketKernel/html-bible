{
  "name": "auth-password",
  "description": "Change the password: the current one is required, the other devices are signed out, this one stays.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/auth/login",
        "body": {
          "login": "elena",
          "password": "elena-demo"
        }
      },
      "save": {
        "here": "token"
      },
      "response": {
        "status": 200,
        "body": {
          "token": "<token>",
          "user": {
            "id": "5cbfc5b0-9bd2-5637-bfe0-7d28368f5ace",
            "number": 4,
            "login": "elena",
            "displayName": "Elena",
            "createdAt": "2026-09-29T10:00:00.000Z",
            "invitedBy": {
              "id": "00000000-0000-4000-8000-000000000001",
              "displayName": "root"
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/auth/login",
        "body": {
          "login": "elena",
          "password": "elena-demo"
        }
      },
      "save": {
        "there": "token"
      },
      "response": {
        "status": 200,
        "body": {
          "token": "<token>",
          "user": {
            "id": "5cbfc5b0-9bd2-5637-bfe0-7d28368f5ace",
            "number": 4,
            "login": "elena",
            "displayName": "Elena",
