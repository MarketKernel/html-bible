            "id": "00000000-0000-4000-8000-000000000001",
            "displayName": "root"
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/v1/me",
        "headers": {
          "Authorization": "Bearer {there}"
        }
      },
      "response": {
        "status": 401,
        "body": {
          "error": {
            "code": "invalid_token",
            "message": "Unknown or revoked token"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/auth/login",
        "body": {
          "login": "elena",
          "password": "elena-demo"
        }
      },
      "response": {
        "status": 401,
        "body": {
