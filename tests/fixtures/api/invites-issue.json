      "request": {
        "method": "POST",
        "path": "/v1/invites",
        "headers": {
          "Authorization": "Bearer <token:anna>"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "seq": 1,
          "code": "2-1-PHFF6-7X471"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/invites",
        "headers": {
          "Authorization": "Bearer <token:anna>"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "seq": 2,
          "code": "2-2-4B3EP-TNBX4"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/v1/invites",
        "headers": {
