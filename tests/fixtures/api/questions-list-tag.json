{
  "name": "questions-list-tag",
  "description": "Filter by tag; an unknown tag gives an empty list.",
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/v1/questions?tag=eschatology"
      },
      "response": {
        "status": 200,
        "body": {
          "questions": []
        }
      }
    }
  ]
}
