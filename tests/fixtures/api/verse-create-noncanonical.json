{
  "name": "verse-create-noncanonical",
  "description": "Deuterocanonical books are refused: 400 noncanonical_ref.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/arguments/01JAS000000000000000000A02/verses",
        "headers": {
          "Authorization": "Bearer <jwt:elena>"
        },
        "body": {
          "ref": {
            "from": "WIS.7.25",
            "to": "WIS.7.26"
          }
        }
      },
      "response": {
        "status": 400,
        "body": {
          "error": {
            "code": "noncanonical_ref",
            "message": "WIS is not a canonical book; discussions only cite the 66 canonical books",
            "field": "ref.from"
          }
        }
      }
    }
  ]
}
