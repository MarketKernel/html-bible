{
  "name": "html-bible",
  "version": "0.1.0",
  "private": true,
  "description": "A Bible reader in one HTML file: search, readable verse links, translations, commentaries and discussions",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --config config/build.dev.json",
    "watch": "node build.mjs --config config/build.dev.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "node tools/run-tests.mjs",
    "test:server": "cargo test --quiet --all-features --manifest-path server/Cargo.toml",
    "test:browser": "node tests/app.mjs",
    "server": "cargo run --quiet --manifest-path server/Cargo.toml --bin local -- --port 8787",
    "i18n": "node tools/i18n.mjs",
    "shots": "node tools/shots.mjs",
    "check": "npm run typecheck && npm test && npm run test:server && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
